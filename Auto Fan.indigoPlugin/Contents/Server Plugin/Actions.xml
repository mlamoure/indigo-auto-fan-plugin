<?xml version="1.0"?>
<Actions>
    <Action id="reset_all_locks">
        <Name>Reset All Zone Locks</Name>
        <CallbackMethod>reset_all_locks</CallbackMethod>
    </Action>
    <Action id="reset_zone_locks">
        <Name>Reset Specific Zone Lock</Name>
        <CallbackMethod>reset_zone_lock</CallbackMethod>
        <ConfigUI>
            <Field id="zone_list" type="menu">
                <Label>Zone:</Label>
                <List class="self" filter="stuff" method="get_zone_list"/>
            </Field>
        </ConfigUI>
    </Action>
    <Action id="create_variable" uiPath="hidden">
        <Name>create a new indigo variable</Name>
        <CallbackMethod>create_variable</CallbackMethod>
    </Action>
    <Action id="enable_all_zones">
        <Name>Enable All Zones</Name>
        <CallbackMethod>change_zones_enabled</CallbackMethod>
    </Action>
    <Action id="disable_all_zones">
        <Name>Disable All Zones</Name>
        <CallbackMethod>change_zones_enabled</CallbackMethod>
    </Action>
    <Action id="enable_zone">
        <Name>Enable Zone</Name>
        <CallbackMethod>change_zones_enabled</CallbackMethod>
        <ConfigUI>
            <Field id="zone_list" type="menu">
                <Label>Zone:</Label>
                <List class="self" filter="stuff" method="get_zone_list"/>
            </Field>
        </ConfigUI>
    </Action>
    <Action id="disable_zone">
        <Name>Disable Zone</Name>
        <CallbackMethod>change_zones_enabled</CallbackMethod>
        <ConfigUI>
            <Field id="zone_list" type="menu">
                <Label>Zone:</Label>
                <List class="self" filter="stuff" method="get_zone_list"/>
            </Field>
        </ConfigUI>
    </Action>
    <Action id="set_comfort_offset">
        <Name>Set Comfort Offset</Name>
        <CallbackMethod>set_comfort_offset</CallbackMethod>
        <ConfigUI>
            <Field id="zone_list" type="menu">
                <Label>Zone:</Label>
                <List class="self" filter="stuff" method="get_zone_list"/>
            </Field>
            <Field id="offset" type="menu" defaultValue="-1.0">
                <Label>Offset (°F added to the ideal):</Label>
                <List>
                    <Option value="-3.0">-3.0 (much cooler)</Option>
                    <Option value="-2.5">-2.5</Option>
                    <Option value="-2.0">-2.0</Option>
                    <Option value="-1.5">-1.5</Option>
                    <Option value="-1.0">-1.0 (a degree cooler)</Option>
                    <Option value="-0.5">-0.5</Option>
                    <Option value="0.5">+0.5</Option>
                    <Option value="1.0">+1.0 (a degree warmer)</Option>
                    <Option value="1.5">+1.5</Option>
                    <Option value="2.0">+2.0</Option>
                    <Option value="2.5">+2.5</Option>
                    <Option value="3.0">+3.0 (much warmer)</Option>
                </List>
            </Field>
            <Field id="until" type="menu" defaultValue="daily_reset">
                <Label>Until:</Label>
                <List>
                    <Option value="night_end">the zone's night window ends</Option>
                    <Option value="night_start">the zone's night window begins</Option>
                    <Option value="daily_reset">the daily reset hour</Option>
                    <Option value="hours">a number of hours from now</Option>
                </List>
            </Field>
            <Field id="hours" type="textfield" defaultValue="4" visibleBindingId="until" visibleBindingValue="hours">
                <Label>Hours:</Label>
            </Field>
        </ConfigUI>
    </Action>
    <Action id="clear_comfort_offset">
        <Name>Clear Comfort Offset</Name>
        <CallbackMethod>clear_comfort_offset</CallbackMethod>
        <ConfigUI>
            <Field id="zone_list" type="menu">
                <Label>Zone:</Label>
                <List class="self" filter="stuff" method="get_zone_list"/>
            </Field>
        </ConfigUI>
    </Action>
    <!-- IWS Actions for Web Configuration Interface -->
    <Action id="web_ui" uiPath="hidden">
        <Name>Web UI Handler</Name>
        <CallbackMethod>handle_web_ui</CallbackMethod>
    </Action>
</Actions>
